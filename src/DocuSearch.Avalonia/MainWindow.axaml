<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DocuSearch.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="DocuSearch.Avalonia.MainWindow"
        Title="DocuSearch" Width="1400" Height="900"
        Background="#FFFFFF"
        WindowState="Maximized">

    <DockPanel LastChildFill="True">

        <!-- ════════════════════════════════════════════════════════ -->
        <!--  HEADER BAR — clean, white, generous spacing                 -->
        <!-- ════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="24,14,24,14"
                BorderBrush="#EFEFEF" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Logo + name (left) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7" Background="#E8842C">
                        <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DocuSearch" Classes="h1" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search + actions (center-right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Classes="searchBox" MinWidth="320"
                             Watermark="Search documents…" Text="{Binding SearchQuery}"
                             KeyDown="OnSearchKeyDown"/>
                    <Button Classes="primary" Content="Search" Command="{Binding SearchCommand}"/>
                    <Button Classes="ghost" Content="＋ Folder" Command="{Binding AddFolderCommand}"/>
                    <Button Classes="ghost" Content="Extract" Command="{Binding ExtractCommand}"/>
                    <Button Classes="ghost" Content="Duplicates" Command="{Binding FindDuplicatesCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════ -->
        <!--  STATUS BAR — minimal, subtle                                -->
        <!-- ════════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="#FAFAFA" Padding="24,7"
                BorderBrush="#EFEFEF" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusText}" Classes="tertiary" VerticalAlignment="Center"/>
                <TextBlock Text="·" Classes="tertiary" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding IndexedCount}" Classes="tertiary" VerticalAlignment="Center"/>
                <TextBlock Text="·" Classes="tertiary" VerticalAlignment="Center"/>
                <Button Classes="pill" Content="{Binding OcrStatusText}"/>
                <Button Classes="pill" Content="{Binding SemanticToggleText}" Command="{Binding ToggleSemanticCommand}"/>
                <Button Classes="pill" Content="{Binding ThemeToggleText}" Command="{Binding ToggleThemeCommand}"/>
                <Button Classes="pill" Content="Open" Command="{Binding OpenLocationCommand}"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════ -->
        <!--  MAIN CONTENT — 3-column grid with generous gaps              -->
        <!-- ════════════════════════════════════════════════════════ -->
        <Grid ColumnDefinitions="360,*,300" Margin="0">

            <!-- ── COLUMN 1: Results ── -->
            <Grid Grid.Column="0" Margin="16,12,8,12">
                <Border Background="#FFFFFF" CornerRadius="12"
                        BorderBrush="#EFEFEF" BorderThickness="1" ClipToBounds="True">
                    <DockPanel>
                        <!-- Results header -->
                        <Border DockPanel.Dock="Top" Padding="16,14,16,10">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Results" Classes="h1"/>
                                <TextBlock Text="{Binding ResultCountText}" Classes="tertiary"/>
                            </StackPanel>
                        </Border>
                        <Border DockPanel.Dock="Top" Height="1" Background="#EFEFEF"/>

                        <!-- Results list -->
                        <ListBox x:Name="ResultsList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="6,4"
                                 ItemsSource="{Binding SearchResults}"
                                 SelectedIndex="{Binding SelectedResultIndex}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" CornerRadius="8" Margin="2,1">
                                        <StackPanel Spacing="6">
                                            <!-- Top row: badge + filename -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Width="28" Height="28" CornerRadius="6"
                                                        Background="{Binding BadgeColor}">
                                                    <TextBlock Text="{Binding BadgeLabel}" Foreground="White"
                                                               FontWeight="Bold" FontSize="9"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding Filename}" Classes="h2"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <!-- Snippet -->
                                            <TextBlock Text="{Binding Snippet}" Classes="secondary"
                                                       TextTrimming="CharacterEllipsis" Margin="36,0,0,0"/>
                                            <!-- Meta line -->
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="36,0,0,0">
                                                <TextBlock Text="{Binding MetaLine}" Classes="tertiary"/>
                                                <Border Background="#FFF4E8" CornerRadius="4" Padding="5,1"
                                                        IsVisible="{Binding HasScore}">
                                                    <TextBlock Text="{Binding ScoreText}" Classes="accent"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ── COLUMN 2: Preview ── -->
            <Grid Grid.Column="1" Margin="8,12,8,12">
                <Border Background="#FFFFFF" CornerRadius="12"
                        BorderBrush="#EFEFEF" BorderThickness="1" ClipToBounds="True">
                    <DockPanel>
                        <!-- Preview header -->
                        <Border DockPanel.Dock="Top" Padding="16,14,16,10"
                                BorderBrush="#EFEFEF" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding PreviewTitle}" Classes="h1"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <!-- Preview content -->
                        <TextBox Classes="previewText" Text="{Binding PreviewText}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 IsHitTestVisible="False"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ── COLUMN 3: Metadata + Tags + Notes ── -->
            <Grid Grid.Column="2" Margin="8,12,16,12">
                <Border Background="#FFFFFF" CornerRadius="12"
                        BorderBrush="#EFEFEF" BorderThickness="1" ClipToBounds="True">
                    <ScrollViewer Background="Transparent" Padding="0">
                        <StackPanel Spacing="0">

                            <!-- Metadata section -->
                            <StackPanel Margin="16,14,16,14" Spacing="10">
                                <TextBlock Text="METADATA" Classes="sectionLabel"/>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Path" Classes="tertiary"/>
                                    <TextBlock Text="{Binding SelectedFilePath}" Classes="body" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Size" Classes="tertiary"/>
                                    <TextBlock Text="{Binding SelectedFileSize}" Classes="body"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Modified" Classes="tertiary"/>
                                    <TextBlock Text="{Binding SelectedFileDate}" Classes="body"/>
                                </StackPanel>
                                </Grid>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="SHA-256" Classes="tertiary"/>
                                    <TextBlock Text="{Binding SelectedFileHash}" Classes="tertiary"/>
                                </StackPanel>
                            </StackPanel>

                            <Separator Margin="16,0"/>

                            <!-- Tags section -->
                            <StackPanel Margin="16,14,16,14" Spacing="10">
                                <TextBlock Text="TAGS" Classes="sectionLabel"/>
                                <ItemsControl ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="tagChip" Margin="0,0,4,4">
                                                <TextBlock Text="{Binding}" Classes="body" FontSize="11"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Separator Margin="16,0"/>

                            <!-- Notes section -->
                            <StackPanel Margin="16,14,16,14" Spacing="10">
                                <TextBlock Text="NOTES" Classes="sectionLabel"/>
                                <TextBox Classes="noteInput" Text="{Binding Notes}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="80" Watermark="Write a note…"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
