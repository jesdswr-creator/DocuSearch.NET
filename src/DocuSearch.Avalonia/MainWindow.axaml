<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DocuSearch.Avalonia.MainWindow"
        Title="DocuSearch" Width="1280" Height="800"
        Background="#F8F9FA"
        WindowState="Maximized">
    <DockPanel>
        <!-- TOP MENU BAR -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="16,8"
                BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="6" Background="#E8842C">
                        <TextBlock Text="D" Foreground="White" FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DocuSearch" FontWeight="Bold" FontSize="14" Foreground="#1A1A1A"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="ghost" Content="Search" Command="{Binding ShowSearchCommand}"/>
                    <Button Classes="ghost" Content="Duplicates" Command="{Binding FindDuplicatesCommand}"/>
                    <Button Classes="ghost" Content="Stats" Command="{Binding ShowStatsCommand}"/>
                    <Button Classes="ghost" Content="Settings" Command="{Binding ShowSettingsCommand}"/>
                    <Button Classes="ghost" Content="Help" Command="{Binding ShowHelpCommand}"/>
                    <Button Classes="ghost" Content="About" Command="{Binding ShowAboutCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SEARCH ROW -->
        <Border DockPanel.Dock="Top" Background="#FFFFFF" Padding="16,8"
                BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBox x:Name="SearchBox" Classes="searchBox" Width="340"
                         Watermark="Search documents..." Text="{Binding SearchQuery}"
                         KeyDown="OnSearchKeyDown"/>
                <Button Classes="primary" Content="Search" Command="{Binding SearchCommand}"/>
                <Border Width="1" Background="#EEEEEE" Margin="4,4"/>
                <Button Classes="ghost" Content="+ Add Folder" Command="{Binding AddFolderCommand}"/>
                <Button Classes="ghost" Content="Add Drive" Command="{Binding AddDriveCommand}"/>
                <Button Classes="ghost" Content="Extract" Command="{Binding ExtractCommand}"/>
            </StackPanel>
        </Border>

        <!-- STATUS BAR -->
        <Border DockPanel.Dock="Bottom" Background="#FFFFFF" Padding="16,6"
                BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="#999999" FontSize="11"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding IndexedCount}" Foreground="#999999" FontSize="11" VerticalAlignment="Center"/>
                    <Button Classes="pill" Content="{Binding SemanticToggleText}" Command="{Binding ToggleSemanticCommand}"/>
                    <Button Classes="pill" Content="Open" Command="{Binding OpenLocationCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN 3-PANEL WITH SPLIT CENTER -->
        <Grid ColumnDefinitions="320,*,260" Margin="12,8">

            <!-- LEFT: Results -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" Margin="0,0,6,0"
                    BorderBrush="#EEEEEE" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8" Spacing="1">
                        <TextBlock Text="Results" FontWeight="Bold" FontSize="13" Foreground="#1A1A1A"/>
                        <TextBlock Text="{Binding ResultCountText}" Foreground="#999999" FontSize="11"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="#F5F5F5"/>
                    <ListBox ItemsSource="{Binding SearchResults}" SelectedIndex="{Binding SelectedResultIndex}" Padding="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="3" Margin="4,4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="22" Height="22" CornerRadius="5" Background="{Binding BadgeColor}">
                                            <TextBlock Text="{Binding BadgeLabel}" Foreground="White" FontWeight="Bold" FontSize="8"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Filename}" FontWeight="SemiBold" Foreground="#1A1A1A" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Snippet}" Foreground="#888888" FontSize="11" Margin="28,0,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding MetaLine}" Foreground="#AAAAAA" FontSize="10" Margin="28,0,0,0"
                                               FontFamily="Cascadia Code, Consolas"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- CENTER: Split (file info top, extracted text bottom) -->
            <Grid Grid.Column="1" Margin="6,0" RowDefinitions="*,4,*">
                <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="10"
                        BorderBrush="#EEEEEE" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewTitle}" FontWeight="Bold" FontSize="13"
                                   Foreground="#1A1A1A" Margin="14,12,14,8" TextTrimming="CharacterEllipsis"/>
                        <Border DockPanel.Dock="Top" Height="1" Background="#F5F5F5"/>
                        <ScrollViewer Padding="14,10">
                            <TextBlock Text="{Binding SelectedFilePath}" Foreground="#666666" FontSize="12"
                                       TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <GridSplitter Grid.Row="1" Background="#EEEEEE" HorizontalAlignment="Stretch"/>
                <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="10"
                        BorderBrush="#EEEEEE" BorderThickness="1">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Extracted Text" FontWeight="Bold" FontSize="12"
                                   Foreground="#1A1A1A" Margin="14,10,14,6"/>
                        <Border DockPanel.Dock="Top" Height="1" Background="#F5F5F5"/>
                        <ScrollViewer Padding="14,8">
                            <TextBlock Text="{Binding PreviewText}" Foreground="#333333" FontSize="13" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- RIGHT: Metadata -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" Margin="6,0,0,0"
                    BorderBrush="#EEEEEE" BorderThickness="1">
                <ScrollViewer Padding="14,12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="METADATA" Foreground="#AAAAAA" FontSize="10" FontWeight="SemiBold"/>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Path" Foreground="#AAAAAA" FontSize="10"/>
                            <TextBlock Text="{Binding SelectedFilePath}" Foreground="#333333" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Size" Foreground="#AAAAAA" FontSize="10"/>
                            <TextBlock Text="{Binding SelectedFileSize}" Foreground="#333333" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Modified" Foreground="#AAAAAA" FontSize="10"/>
                            <TextBlock Text="{Binding SelectedFileDate}" Foreground="#333333" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="SHA-256" Foreground="#AAAAAA" FontSize="10"/>
                            <TextBlock Text="{Binding SelectedFileHash}" Foreground="#AAAAAA" FontSize="10"
                                       FontFamily="Cascadia Code, Consolas"/>
                        </StackPanel>
                        <TextBlock Text="TAGS" Foreground="#AAAAAA" FontSize="10" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F5F5F5" CornerRadius="10" Padding="8,3" Margin="0,0,4,4">
                                        <TextBlock Text="{Binding}" Foreground="#333333" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="NOTES" Foreground="#AAAAAA" FontSize="10" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="#FAFAFA" Foreground="#1A1A1A" BorderBrush="#EEEEEE"
                                 CornerRadius="6" Padding="8" MinHeight="60" Watermark="Write a note..."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
